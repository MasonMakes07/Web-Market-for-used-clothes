# Local marketplace preview works without environment variables.
# Add public connection settings to .env.local when connecting services.
VITE_SCANNER_API=http://localhost:8000
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-public-client-id
VITE_AUTH0_AUDIENCE=https://api.your-marketplace.example
# Optional: return to the original website implementation.
# VITE_APP_EXPERIENCE=legacy

# Exact Auth0 enterprise connection name, only after UCSD SSO is configured.
# UCSD manages its Duo step; never collect university passwords in this app.
VITE_UCSD_AUTH0_CONNECTION=

# Social sign-in fallback. Enable the matching providers in Auth0 first.
VITE_GOOGLE_AUTH0_CONNECTION=google-oauth2
# Set to apple after its Auth0/Apple provider configuration is complete.
VITE_APPLE_AUTH0_CONNECTION=

# Separate Auth0 Native application client for the iOS build. Public ID only.
VITE_AUTH0_NATIVE_CLIENT_ID=
