# Copy to backend/.env. Never put these values in a VITE_ variable.
OPENAI_API_KEY=
OPENAI_SCAN_MODEL=gpt-5.4-mini
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.your-marketplace.example
# Comma-separated Auth0 subjects. Admit only students whose email/enrollment you checked.
APPROVED_AUTH0_SUBJECTS=
ALLOWED_ORIGINS=http://localhost:5173
# Attempts, including errors, count. Persistent storage must be shared by all workers.
SCAN_DAILY_LIMIT=3
SCAN_MONTHLY_LIMIT=200

# Required campus connection name matching the Auth0 post-login Action.
UCSD_AUTH0_CONNECTION=

# Use social only after deploying the Google/Apple identity Action.
# Social mode verifies account ownership; it does not prove UCSD enrollment.
SCANNER_AUTH_MODE=campus
